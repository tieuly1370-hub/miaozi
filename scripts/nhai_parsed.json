 "grammar": {
  "2": {
   "title": "Tôi tên là NhaiHSK",
   "url": "https://nhaihsk.com/grammar/hsk1/lesson-2",
   "patterns": [
    {
     "name": "主语 + 谓语 + 宾语",
     "explain": "Nòng cốt câu trần thuật tiếng Trung theo thứ tự chủ ngữ–động từ–tân ngữ, như tiếng Việt.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-2/pattern-1"
    }
   ]
  },
  "3": {
   "title": "Tôi là người Việt Nam",
   "url": "https://nhaihsk.com/grammar/hsk1/lesson-3",
   "patterns": [
    {
     "name": "Câu chữ “是”",
     "explain": "Câu chữ 是 khẳng định A chính là B hoặc A thuộc về loại B.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-3/pattern-1"
    },
    {
     "name": "Trợ từ kết cấu “的”",
     "explain": "Trợ từ kết cấu 的 nối định ngữ với danh từ trung tâm đứng sau, thể hiện quan hệ sở hữu hoặc tu sức.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-3/pattern-2"
    },
    {
     "name": "……吗？",
     "explain": "Thêm 吗 cuối câu trần thuật để tạo câu hỏi có/không; giữ nguyên trật tự câu.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-3/pattern-3"
    }
   ]
  },
  "4": {
   "title": "Tôi có hai đứa con",
   "url": "https://nhaihsk.com/grammar/hsk1/lesson-4",
   "patterns": [
    {
     "name": "“有”字句 (1)",
     "explain": "Dùng 有 để nói một chủ thể có/sở hữu cái gì.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-4/pattern-1"
    },
    {
     "name": "“百”以上(含)、“万”以内数字的写法与读法",
     "explain": "Cách đọc/viết số 100–9999 theo bậc 千–百–十–đơn vị.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-4/pattern-2"
    },
    {
     "name": "“2” 的写法和读法",
     "explain": "Số 2 đọc 二 khi đọc con số, 两 khi chỉ số lượng trước lượng từ.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-4/pattern-3"
    },
    {
     "name": "A……，B呢？",
     "explain": "Nêu thông tin mình trước rồi thêm “đối tượng + 呢？” để hỏi lại đúng nội dung đó.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-4/pattern-4"
    },
    {
     "name": "Số từ + Lượng từ + Danh từ [Num+M+(N)]",
     "explain": "Số từ phải đi qua lượng từ trước danh từ; khung Số từ + Lượng từ + Danh từ.",
     "url": "https://nhaihsk.com/grammar/hsk1/lesson-4/pattern-5"
    }
   ]
  },
